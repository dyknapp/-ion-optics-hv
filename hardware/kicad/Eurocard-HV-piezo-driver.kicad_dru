(version 1)
(rule "class 1:1"
  (condition "A.NetClass == 'USB' && B.NetClass == 'USB'")
  (constraint clearance (min 0.2mm)))



# Manual +/-250 V polarity selection: enforce the union of both configurations.
# Outer copper only (F.Cu and B.Cu); internal copper keeps existing rules.
# Nets along one RC-filter branch are treated as one voltage family. Spacing
# within that family keeps the existing rules; spacing to other families or
# other nets is at least 1.25 mm. This avoids imposing HV spacing across the
# small voltage drop of each series filter resistor.
# Both preselector branches can be at HV relative to GND. The selected return
# branch (HV_RETURN_IN, Net-(C22-2), HV_MIDGND) stays near the servo voltage.
# D1's anode is a separate HV switching node; 1.25 mm is a minimum, not a
# validation of its transient voltage rating.
# These rules do not depend on POS/NEG fitted or DNP status. Never fit both
# polarity link sets. Review exact NetName lists after net-label/reannotation
# changes, especially autogenerated Net-(...) names.
# Do not add smaller pad/footprint local clearance overrides: in KiCad these
# can take priority over custom clearance rules.

(rule "HV pre-positive to other nets (outer)"
  (layer outer)
  (condition "((((A.NetName == 'HV_0') || (A.NetName == 'Net-(C12-1)') || (A.NetName == '/Eurocard-HV-piezo-driver_1/HV_PRE_FILTER_IN')) && (!((B.NetName == 'HV_0') || (B.NetName == 'Net-(C12-1)') || (B.NetName == '/Eurocard-HV-piezo-driver_1/HV_PRE_FILTER_IN')))) || (((B.NetName == 'HV_0') || (B.NetName == 'Net-(C12-1)') || (B.NetName == '/Eurocard-HV-piezo-driver_1/HV_PRE_FILTER_IN')) && (!((A.NetName == 'HV_0') || (A.NetName == 'Net-(C12-1)') || (A.NetName == '/Eurocard-HV-piezo-driver_1/HV_PRE_FILTER_IN')))))")
  (constraint clearance (min 1.25mm)))

(rule "HV pre-negative to other nets (outer)"
  (layer outer)
  (condition "((((A.NetName == 'GND_0') || (A.NetName == 'Net-(C12-2)') || (A.NetName == '/Eurocard-HV-piezo-driver_1/HV_PRE_RETURN_IN')) && (!((B.NetName == 'GND_0') || (B.NetName == 'Net-(C12-2)') || (B.NetName == '/Eurocard-HV-piezo-driver_1/HV_PRE_RETURN_IN')))) || (((B.NetName == 'GND_0') || (B.NetName == 'Net-(C12-2)') || (B.NetName == '/Eurocard-HV-piezo-driver_1/HV_PRE_RETURN_IN')) && (!((A.NetName == 'GND_0') || (A.NetName == 'Net-(C12-2)') || (A.NetName == '/Eurocard-HV-piezo-driver_1/HV_PRE_RETURN_IN')))))")
  (constraint clearance (min 1.25mm)))

(rule "HV selected output to other nets (outer)"
  (layer outer)
  (condition "((((A.NetName == '/Eurocard-HV-piezo-driver_1/HV_FILTER_IN') || (A.NetName == 'Net-(C22-1)') || (A.NetName == 'HV')) && (!((B.NetName == '/Eurocard-HV-piezo-driver_1/HV_FILTER_IN') || (B.NetName == 'Net-(C22-1)') || (B.NetName == 'HV')))) || (((B.NetName == '/Eurocard-HV-piezo-driver_1/HV_FILTER_IN') || (B.NetName == 'Net-(C22-1)') || (B.NetName == 'HV')) && (!((A.NetName == '/Eurocard-HV-piezo-driver_1/HV_FILTER_IN') || (A.NetName == 'Net-(C22-1)') || (A.NetName == 'HV')))))")
  (constraint clearance (min 1.25mm)))

(rule "HV flyback switching node to other nets (outer)"
  (layer outer)
  (condition "((((A.NetName == 'Net-(D1-A)')) && (!((B.NetName == 'Net-(D1-A)')))) || (((B.NetName == 'Net-(D1-A)')) && (!((A.NetName == 'Net-(D1-A)')))))")
  (constraint clearance (min 1.25mm)))
